#version 450
layout (local_size_x = 16, local_size_y = 16) in;
layout(rgba8, set = 0, binding = 0) uniform image2D image;
layout(push_constant) uniform constants {
    vec4 data1;
    vec4 data2;
    vec4 data3;
    vec3 data4;
    highp uint time;
} PC;
#define PI 3.14159265359
#define TAU 6.28318530718

vec3 palette(float t) {
    return 0.5 + 0.5 * cos(TAU * (t + vec3(0.0, 0.33, 0.67)));
}

float sphereSDF(vec3 p, float r) {
    return length(p) - r;
}

float sceneSDF(vec3 p) {
    float mergeProgress = smoothstep(0.0, 1.0, mod(float(PC.time) * 0.001, 1.0));

    vec3 pos1 = vec3(-1.0, 1.0, -5.0);
    vec3 pos2 = vec3(1.0, 1.0, -5.0);
    vec3 pos3 = vec3(-1.0, -1.0, -5.0);
    vec3 pos4 = vec3(1.0, -1.0, -5.0);
    vec3 pos5 = vec3(0.0, 1.5, -5.0);
    vec3 pos6 = vec3(0.0, -1.5, -5.0);

    vec3 center1 = mix(vec3(0.0), pos1, mergeProgress);
    vec3 center2 = mix(vec3(0.0), pos2, mergeProgress);
    vec3 center3 = mix(vec3(0.0), pos3, mergeProgress);
    vec3 center4 = mix(vec3(0.0), pos4, mergeProgress);
    vec3 center5 = mix(vec3(0.0), pos5, mergeProgress);
    vec3 center6 = mix(vec3(0.0), pos6, mergeProgress);

    float d1 = sphereSDF(p - center1, 0.5);
    float d2 = sphereSDF(p - center2, 0.5);
    float d3 = sphereSDF(p - center3, 0.5);
    float d4 = sphereSDF(p - center4, 0.5);
    float d5 = sphereSDF(p - center5, 0.5);
    float d6 = sphereSDF(p - center6, 0.5);

    return min(min(min(d1, d2), min(d3, d4)), min(d5, d6));
}

vec3 estimateNormal(vec3 p) {
    const vec2 e = vec2(0.001, 0.0);
    return normalize(vec3(
                     sceneSDF(p + e.xyy) - sceneSDF(p - e.xyy),
                     sceneSDF(p + e.yxy) - sceneSDF(p - e.yxy),
                     sceneSDF(p + e.yyx) - sceneSDF(p - e.yyx)
                     ));
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    vec2 res = vec2(imageSize(image));
    vec2 uv = (vec2(pix) - 0.5 * res) / res.y;

    vec3 ro = vec3(0.0, 0.0, 3.0);
    vec3 rd = normalize(vec3(uv, -1.0));

    float t = 0.0;
    vec3 col = vec3(0.0);
    bool hit = false;

    for (int i = 0; i < 100; i++) {
        vec3 p = ro + t * rd;
        float d = sceneSDF(p);
        if (d < 0.001) {
            vec3 normal = estimateNormal(p);
            float diff = max(dot(normal, normalize(vec3(1.0, 1.0, 1.0))), 0.0);
            col = palette(t * 0.1 + float(PC.time) * 0.0003) * diff;
            hit = true;
            break;
        }
        t += d;
        if (t > 10.0) break;
    }

    // Add background gradient if no hit
    if (!hit) {
        col = mix(vec3(0.1, 0.2, 0.3), vec3(0.2, 0.3, 0.5), uv.y + 0.5);
    }

    // Apply gamma correction
    col = pow(col, vec3(0.4545));

    imageStore(image, pix, vec4(col, 1.0));
}